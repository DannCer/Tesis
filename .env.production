# ==============================================================================
# PRODUCCIÓN — .env.production
# Ajusta cada valor a tu dominio y servidor antes de desplegar.
# NUNCA commitees este archivo con credenciales reales.
# ==============================================================================

# ── API REST (FastAPI) ─────────────────────────────────────────────────────────
VITE_API_URL=https://TU_DOMINIO/api

# ── QGIS Server ───────────────────────────────────────────────────────────────
VITE_QGIS_SERVER_URL=https://TU_DOMINIO/qgis/qgis_mapserv.fcgi.exe

# VITE_QGIS_VECTOR_PROJECT=/srv/qgis/01_Geologicos.qgz
# VITE_QGIS_RASTER_PROJECT=/srv/qgis/02_Raster.qgz

# ── WFS / Capas ────────────────────────────────────────────────────────────────
VITE_WFS_TIMEOUT=30000
VITE_MAX_FEATURES=0

# ── Mapa ───────────────────────────────────────────────────────────────────────
VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_CENTER_LNG=-99.1332
VITE_MAP_ZOOM=11
VITE_MAP_MIN_ZOOM=8
VITE_MAP_MAX_ZOOM=19

# ── Aplicación ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Geovisor
VITE_APP_VERSION=1.0.0
VITE_DEBUG_MODE=false
