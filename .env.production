# ==============================================================================
# PRODUCCIÓN — ajusta cada valor a tu servidor
# ==============================================================================
VITE_API_URL=https://TU_DOMINIO/api

VITE_QGIS_SERVER_URL=https://TU_DOMINIO/qgis/qgis_mapserv.fcgi.exe

# En Linux usa rutas absolutas del servidor, p. ej.:
# /srv/qgis/proyectos/vectoriales.qgz
VITE_QGIS_VECTOR_PROJECT=/srv/qgis/proyectos/vectoriales.qgz
VITE_QGIS_RASTER_PROJECT=/srv/qgis/proyectos/raster.qgz

VITE_WFS_TIMEOUT=30000
VITE_MAX_FEATURES=10000

VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_CENTER_LNG=-99.1332
VITE_MAP_ZOOM=11
VITE_MAP_MIN_ZOOM=8
VITE_MAP_MAX_ZOOM=19

VITE_APP_NAME=Geovisor
VITE_APP_VERSION=1.0.0
VITE_DEBUG_MODE=false
