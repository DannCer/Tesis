# ==============================================================================
# DESARROLLO LOCAL — .env.development
# Todas las variables deben tener el prefijo VITE_ para ser expuestas al cliente.
# ==============================================================================

# ── API REST (FastAPI) ─────────────────────────────────────────────────────────
# Apunta al backend local. En producción usa .env.production.
VITE_API_URL=http://192.168.100.184:8000

# ── QGIS Server ───────────────────────────────────────────────────────────────
VITE_QGIS_SERVER_URL=http://192.168.100.184/qgis/qgis_mapserv.fcgi.exe

# Rutas a los proyectos .qgz en el servidor QGIS.
# QGIS_VECTOR_PROJECT → capas WFS/WMS vectoriales
# QGIS_RASTER_PROJECT → series ráster WMS
# VITE_QGIS_VECTOR_PROJECT=C:/mis_proyectos/01_Geologicos.qgz
# VITE_QGIS_RASTER_PROJECT=C:/mis_proyectos/02_Raster.qgz

# ── WFS / Capas ────────────────────────────────────────────────────────────────
VITE_WFS_TIMEOUT=30000
VITE_MAX_FEATURES=0

# ── Mapa ───────────────────────────────────────────────────────────────────────
VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_CENTER_LNG=-99.1332
VITE_MAP_ZOOM=11
VITE_MAP_MIN_ZOOM=7
VITE_MAP_MAX_ZOOM=19

# ── Aplicación ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Geovisor
VITE_APP_VERSION=1.0.0
VITE_DEBUG_MODE=true
