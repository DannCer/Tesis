# ==================================
# CONFIGURACIÓN DE QGIS SERVER
# ==================================
# URL del ejecutable qgis_mapserv.fcgi.exe
# Windows: http://localhost/qgis/qgis_mapserv.fcgi.exe
# Linux: http://localhostcgi-bin/qgis_mapserv.fcgi
VITE_QGIS_SERVER_URL=http://localhost/qgis/qgis_mapserv.fcgi.exe

# Ruta absoluta al proyecto QGIS (.qgz) para capas vectoriales
# Ejemplo Windows: C:/mis_proyectos/01_Geologicos.qgz
# Ejemplo Linux: /home/user/proyectos/01_Geologicos.qgz
VITE_QGIS_VECTOR_PROJECT=C:/mis_proyectos/01_Geologicos.qgz

# Ruta absoluta al proyecto QGIS (.qgz) para capas ráster
# Puede ser el mismo archivo que el vectorial si contiene ambas capas
VITE_QGIS_RASTER_PROJECT=C:/mis_proyectos/01_Geologicos.qgz

# ==================================
# CONFIGURACIÓN WFS
# ==================================
# Timeout para peticiones WFS en milisegundos
VITE_WFS_TIMEOUT=30000

# Número máximo de features por petición WFS
VITE_MAX_FEATURES=10000

# ==================================
# CONFIGURACIÓN DEL MAPA
# ==================================
# Coordenadas del centro inicial del mapa [lat, lng]
VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_CENTER_LNG=-99.1332

# Niveles de zoom
VITE_MAP_ZOOM=11
VITE_MAP_MIN_ZOOM=8
VITE_MAP_MAX_ZOOM=19

# ==================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==================================
# Nombre de la aplicación (visible en el header)
VITE_APP_NAME=Geovisor CDMX

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# Modo debug (true en desarrollo, false en producción)
VITE_DEBUG_MODE=true
